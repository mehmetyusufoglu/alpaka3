@startuml
!include ../config/plantuml-config.iuml

title Tensor Execution Flow (Queue/Exec/Device)

actor User
rectangle "Host (CPU)" {
  User --> (enqueue op)
}

rectangle "Alpaka" {
  [Exec]
  [Queue]
  [Device]
}

rectangle "Tensor Op" {
  [Prepare Buffers]
  [FrameSpec]
  [Kernel Enqueue]
  [Mark Modified]
}

User --> [Queue] : enqueues
[Exec] -[#grey,dashed]-> [Queue] : schedules by
[Queue] --> [Kernel Enqueue] : submits
[Kernel Enqueue] --> [Device] : executes on
[FrameSpec] -[#grey,dashed]-> [Kernel Enqueue] : configures
[Prepare Buffers] -[#grey,dashed]-> [Kernel Enqueue] : prepares
[Device] -[#grey,dotted]-> [Mark Modified] : synchronizes/coherence

Legend("Connection Legend", "uses: component dependency\nscheduled by: queue scheduling\naccesses through: memory/device path\nsynchronizes: waits/coherence update")
@enduml
