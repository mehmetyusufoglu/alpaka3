@startuml
!include ../config/plantuml-config.iuml

title Inference Layers and Dependencies

package "Core" {
  class "Tensor<T,Rank,Device>" as TensorTRD
  class CleanTensorOpContext
}

package "Ops" {
  class InferenceOps
  class Conv2D
  class Gemm
  class Activations
  class BatchNorm
  class BatchNormFold
  class Pooling
  class Softmax
}

package "Layers (Inference)" {
  class Conv2DLayer
  class LinearLayers
  class ReLULayer
  class SoftmaxLayer
  class NormalizationLayers
  class PoolingLayers
  class EmbeddingLayers
  class AttentionLayers
  class BertLayers
}

Ops ..> TensorTRD : uses
Ops ..> CleanTensorOpContext : provider path (optional)
Conv2DLayer --> Conv2D : uses
LinearLayers --> Gemm : uses
ReLULayer --> Activations : uses
SoftmaxLayer --> Softmax : uses
NormalizationLayers --> BatchNormFold : uses
PoolingLayers --> Pooling : uses
EmbeddingLayers --> InferenceOps : uses
AttentionLayers --> InferenceOps : uses
BertLayers --> InferenceOps : uses

Conv2D ..> CleanTensorOpContext : provider path
Gemm ..> CleanTensorOpContext : provider path
BatchNorm ..> CleanTensorOpContext : provider path

note right of BatchNormFold
Host-side fold used during inference; no provider path
end note

Legend("Connection Legend", "uses: component dependency\nprovider path: vendor-backed call via context\nno provider path: host-side fold/affine")

@enduml
