@startuml
!include ../config/plantuml-config.iuml

title Training Layers and Dependencies

package "Core" {
  class "Tensor<T,Rank,Device>" as TensorTRD
  class CleanTensorOpContext
}

package "Ops (Training)" {
  class TrainingOps
  class TrainingSequential
  class InferenceOps
  class Conv2D
  class Gemm
  class Activations
  class BatchNorm
  class BatchNormFold
}

package "Layers (Training)" {
  class BatchNormLayer
  class Conv2DLayer
  class LinearLayers
  class NormalizationLayers
  class ReLULayer
  class PoolingLayers
}

TrainingOps ..> TensorTRD : uses
TrainingSequential ..> TrainingOps : composes
TrainingSequential ..> InferenceOps : composes

BatchNormLayer --> BatchNormFold : uses
Conv2DLayer --> Conv2D : uses
LinearLayers --> Gemm : uses
NormalizationLayers --> BatchNormFold : uses
ReLULayer --> Activations : uses
PoolingLayers --> InferenceOps : uses

Conv2D ..> CleanTensorOpContext : provider path
Gemm ..> CleanTensorOpContext : provider path
BatchNorm ..> CleanTensorOpContext : provider path

Legend("Connection Legend", "uses: component dependency\ncomposes: layer sequencing/dependency\nprovider path: vendor-backed call via context")

@enduml
